{
  "name": "@quantumcoin/solidity-lib",
  "version": "1.0.0",
  "description": "Solidity libraries shared across QuantumSwap contracts on the QuantumCoin blockchain (modified fork of @uniswap/lib)",
  "license": "GPL-3.0-or-later",
  "files": [
    "contracts",
    "!contracts/test"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantumcoinproject/solidity-lib.git"
  },
  "homepage": "https://github.com/quantumcoinproject/solidity-lib#readme",
  "bugs": {
    "url": "https://github.com/quantumcoinproject/solidity-lib/issues"
  },
  "keywords": [
    "quantumcoin",
    "quantumswap",
    "solidity",
    "libraries"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "node scripts/compile.js",
    "test": "npm run compile && node scripts/devnet.js ensure && node --test --test-concurrency=1",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@quantumcoin/solc": "^0.7.6",
    "quantumcoin": "^8.0.2"
  }
}
